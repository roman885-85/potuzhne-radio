<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ua.potuzhne.radio"
    android:versionCode="10438"
    android:versionName="1.4.38">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- щоб застосунок міг сам поставити своє оновлення (див. Update.java) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- адреса телефона в Wi-Fi — щоб знати, яку сотню адрес перебирати -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- без цього Wi-Fi відкидає групові пакети, а на них тримається пошук за іменем (DNS-SD) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- лише Android 5–9: там збереження в «Завантаження» ще вимагає дозволу -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Голосові команди: мову розпізнає системний застосунок (Google) і віддає
      текст — власного дозволу на мікрофон не треба. З Android 11 без цього
      запису застосунок просто не бачить, чи є на телефоні розпізнавання.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!--
      enableOnBackInvokedCallback: з Android 16 (targetSdk 36) система вже не
      кличе onBackPressed, і «Назад» просто закривав би застосунок. Тому
      «Назад» слухаємо новим способом (OnBackInvokedCallback), а старий
      лишається для Android до 13.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Radio"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:supportsRtl="false">

        <!--
          configChanges: поворот телефона чи зміна розміру вікна не повинні
          перестворювати екран — інакше сторінка радіо вантажилася б наново
          й замовкала посеред прослуховування.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
