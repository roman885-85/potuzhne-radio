<?xml version="1.0" encoding="utf-8"?>
<!--
  Значок для Android 8 і новіших: система сама вирізає форму (коло, квадрат,
  «краплю» — як заведено у виробника), тож тут лише шари. Для старіших
  Android build.sh малює готові PNG з уже обрізаним тлом.
  monochrome — для тематичних значків Android 13+, там фарбує сама система.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
