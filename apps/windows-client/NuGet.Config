<?xml version="1.0" encoding="utf-8"?>
<!-- Лише nuget.org і нічого з налаштувань користувача: збірка має бути однаковою
     на будь-якому Mac. Теку з уже завантаженими пакетами build.sh додає сам. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
